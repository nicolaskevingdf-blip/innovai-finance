# Supabase (Settings > API no painel do projeto)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Opcional — habilita a camada de IA generativa (assistente e interpretação avançada).
# Sem esta chave, a Innovai usa o interpretador determinístico local e o motor de insights por regras.
ANTHROPIC_API_KEY=

# Opcional — somente servidor. Necessária apenas para a exclusão definitiva da conta (LGPD).
SUPABASE_SERVICE_ROLE_KEY=
